# Copy this file to .env and fill in your Supabase project values.
APP_NAME=ALLURE API
APP_VERSION=1.0.0
DEBUG=true

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Frontend origins, comma-separated. Add your deployed frontend origin before deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_SIZE_MB=10
STORAGE_BUCKET=skin-images
SIGNED_URL_TTL_SECONDS=600
MIN_MODEL_CONFIDENCE=0.65

# Leave empty until your partner supplies the model files and a wrapper.
# Format: python.module.path:function_name
ALLURE_MODEL_PIPELINE=
